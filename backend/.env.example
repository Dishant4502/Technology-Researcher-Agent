# ── LLM Provider (pick Groq OR OpenAI) ────────────────────────────────────────
# Groq (preferred – fast & cheap)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# OpenAI (fallback – leave blank if using Groq)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=

# ── Web Search ────────────────────────────────────────────────────────────────
# Tavily provides higher-quality search. Leave blank to fall back to DuckDuckGo.
TAVILY_API_KEY=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost

# ── Knowledge Repo ────────────────────────────────────────────────────────────
RESEARCH_MAX_SOURCES=6
KNOWLEDGE_RETENTION_LIMIT=8
